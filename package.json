{
  "name": "tv-capture",
  "displayName": "TV Capture",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that captures trading setups from TradingView and sends them to Telegram with one click.",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@plasmohq/storage": "^1.15.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "typescript": "5.3.3",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ]
  },
  "manifest": {
    "host_permissions": [
      "https://api.telegram.org/*",
      "https://*.tradingview.com/*"
    ],
    "permissions": [
      "sidePanel",
      "storage",
      "activeTab"
    ],
    "commands": {
      "capture-tradingview": {
        "suggested_key": {
          "default": "Alt+S",
          "mac": "Alt+S"
        },
        "description": "Capture screenshot from TradingView chart"
      }
    }
  }
}
